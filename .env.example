# Copy to `.env` and adjust. Only VITE_-prefixed variables reach the renderer.
# Typed access lives in src/lib/env.ts — add new variables there too.

# Display name used in the header / about page
VITE_APP_NAME="Galaxy File Explorer"

# Data source for the galaxy: "mock" | "tauri"
# mock  -> in-memory demo filesystem (works in a plain browser via `pnpm dev`)
# tauri -> real Windows filesystem through the Rust backend
VITE_FS_PROVIDER="mock"

# Star count in the background starfield
VITE_STAR_COUNT="6000"

# Show the /debug route and on-screen performance stats
VITE_ENABLE_DEBUG="true"
